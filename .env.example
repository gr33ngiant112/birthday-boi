# Copy this file to .env and fill it in: `cp .env.example .env`. .env is gitignored; never commit
# it. `python bot.py` loads .env on a local run; a variable already set in the environment wins.
# The bot needs only DISCORD_TOKEN and REDIS_URL. The others are optional.

# Required. The bot's token, from the Bot page of your Discord application in the Developer
# Portal. Use a separate development application's token here, never the production one.
DISCORD_TOKEN=

# Required. Where Redis listens: here, the Redis that `docker compose -f compose.dev.yaml up -d`
# starts on this machine.
REDIS_URL=redis://127.0.0.1:6379/0

# Optional. The ID of a test server. At every start the bot copies its slash commands there and
# syncs them, so they show up at once. Empty: no server gets this sync.
DEV_GUILD_ID=

# Optional, for rediss:// URLs only. The bot checks the Redis server's certificate and hostname
# unless this is 1, so a server with a self-signed certificate, such as Heroku's, needs it.
# REDIS_TLS_INSECURE=1

# Optional. The host port compose.dev.yaml publishes Redis on (6379 when unset). Compose reads it
# from this file too; use the same port in REDIS_URL.
# REDIS_PORT=6379
